{% extends 'base.html.twig' %}

{% block title %}Disscusion avec ...{% endblock %}

{% block body %}
{# template html pour afficher tous le message d'une discussion #}
<div class="container center mt-5">
	<h1 class="text-center">Disscusion avec ...</h1>
	<div class="row">
		<div class="col-md-8">
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">Sujet de la discussion</h3>
				</div>
				<div class="card-body">
					{% for message in messages %}
					<div class="card mb-3">
						<div class="card-header">
							<p class="card-title">{{ message.user.fullname }}</p>
						</div>
						<div class="card-body">
							<p class="card-text">{{ message.content }}</p>
						</div>
					</div>
					{% endfor %}
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">Envoyer un message</h3>
				</div>
				<div class="card-body">
					<form method="POST">
						<div class="form-group">
							<textarea class="form-control" name="content" placeholder="Votre message"></textarea>
						</div>	
						<div class="form-group">
							<button class="btn btn-primary">Envoyer</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>


{# {{ dump(messages) }} #}



{% endblock %}